# Exporte estas variáveis no ambiente. O Spring não lê este arquivo sozinho.
# Não coloque uma chave real no Git.

POKEMON_TCG_BASE_URL=https://api.pokemontcg.io/v2
POKEMON_TCG_API_KEY=
POKEMON_TCG_TIMEOUT=10s

YUGIOH_API_BASE_URL=https://db.ygoprodeck.com/api/v7
YUGIOH_API_TIMEOUT=10s

MTG_API_BASE_URL=https://api.scryfall.com
MTG_API_TIMEOUT=10s

MONGO_USERNAME=
MONGO_PASSWORD=
MONGODB_URI=

# Pelo menos 32 bytes em UTF-8. Não commite um segredo real.
JWT_SECRET=
JWT_EXPIRATION=24h

# Origens do frontend aceitas pelo CORS, separadas por vírgula. Sem a variável, aceita qualquer origem (só em dev).
# No perfil hml é obrigatória. Não deixe a variável definida e vazia: isso bloqueia todas as origens.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# E-mail de uma conta já cadastrada que deve virar ADMIN na subida. Deixe vazio para não promover ninguém.
ADMIN_EMAIL=
